# Copy this file to .env.trend.local. Never commit the real secret.
TREND_INGEST_URL=https://your-site.example.com/api/trend-discovery/ingest
TREND_INGEST_SECRET=replace-with-the-same-random-secret-configured-on-vercel

# Optional overrides
TREND_NODE_ID=evern-pc-01
TREND_NODE_NAME=个人电脑试行节点
TREND_PROFILE_DIR=.trend-browser
TREND_BROWSER_CHANNEL=chrome
TREND_HEADLESS=false
